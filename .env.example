# Vercel AI Gateway key: used for d1/Jev decisions, and for Gemini if no Google key is set.
AI_GATEWAY_API_KEY=

# Decision model on the gateway (BoligRadar used liquid/d1.2-ultra; Jev is typesafe-ai/jev).
DECISION_MODEL=liquid/d1.2-ultra

# Google AI Studio key. If set, the agents call Gemini directly instead of through the gateway.
GOOGLE_GENERATIVE_AI_API_KEY=

# Gemini model id for the agents. With a Google key: the plain model name from AI Studio.
# Through the gateway: the "google/..." id from https://ai-gateway.vercel.sh/v1/models
GEMINI_MODEL=

# Where the SQLite file lives (the dashboard reads the same file).
SHOAL_DB=../shoal.db
