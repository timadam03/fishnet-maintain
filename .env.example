# Easiest: run `npm run setup` in decision-layer/, which fills these in and tests them.

# Vercel AI Gateway key: decision model and (usually) agent model.
AI_GATEWAY_API_KEY=

# Decision model for typed yes/no questions. liquid/d1.2-ultra works on the free gateway tier;
# google/gemini-decision-1 and typesafe-ai/jev need paid gateway credits.
DECISION_MODEL=liquid/d1.2-ultra

# Chat model for the investigator and curator. A gateway id with a slash
# (e.g. nvidia/nemotron-3.5-lightning-free, free tier) uses AI_GATEWAY_API_KEY; a plain Gemini
# name (e.g. gemini-3.8-flash) uses GOOGLE_GENERATIVE_AI_API_KEY from AI Studio.
AGENT_MODEL=nvidia/nemotron-3.5-lightning-free

# Only needed for a plain Gemini name in AGENT_MODEL.
GOOGLE_GENERATIVE_AI_API_KEY=

# Where the SQLite file lives (the dashboard reads the same file).
SHOAL_DB=../shoal.db
